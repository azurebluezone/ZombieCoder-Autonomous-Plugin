{
  "name": "zombiecoder-opencode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZombieCoder agent pack for OpenCode: emits the agent folder, binds every agent under shared rules, and gives each working directory an SSOT, a hierarchical syllabus footprint and local conversation memory.",
  "exports": {
    ".": "./src/plugin.ts"
  },
  "bin": {
    "zombiecoder": "./bin/install.mjs"
  },
  "scripts": {
    "install-pack": "node --experimental-strip-types bin/install.mjs",
    "setup": "node scripts/setup.mjs",
    "configure": "node --experimental-strip-types scripts/configure.mjs",
    "generate": "node --experimental-strip-types src/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "quick-install": "node bin/quick-install.mjs",
    "integrity": "node scripts/integrity.mjs",
    "integrity:check": "node scripts/integrity.mjs --check",
    "identity": "node scripts/identity.mjs --write",
    "identity:check": "node scripts/identity.mjs",
    "lsp:probe": "node scripts/lsp-probe.mjs",
    "mcp:image-brand": "node mcp/image-brand/server.mjs",
    "mcp:image-brand:check": "node mcp/image-brand/selfcheck.mjs",
    "mcp:image-brand:test": "node --test mcp/image-brand/test/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run identity:check && npm run integrity:check"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.32"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "license": "SEE LICENSE IN LICENSE"
}
